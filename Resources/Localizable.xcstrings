    "settings.shortcuts.persistence.loadFailed" : {
      "comment" : "Shortcuts settings - Configuration could not be loaded; edits are blocked until retry or explicit recovery",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gesicherten Tastaturkurzbefehle konnten nicht gelesen werden. Versuche es erneut oder wähle „Alle auf Standardwerte zurücksetzen“, um eine Wiederherstellungskopie zu behalten und die Standardwerte zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved shortcuts could not be read. Retry, or choose Reset All to Defaults to keep a recovery copy and use the defaults."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les raccourcis enregistrés. Réessayez, ou choisissez « Tout réinitialiser aux valeurs par défaut » pour conserver une copie de récupération et utiliser les valeurs par défaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたショートカットを読み込めませんでした。再試行するか、「すべてをデフォルトにリセット」を選択してください。リセットすると、復旧用のコピーが保持され、デフォルトが使用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已存储的快捷键。请重试，或选择「全部重置为默认」以保留一份恢复副本并使用默认设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取已儲存的快速鍵。請重試，或選擇「全部重設為預設值」，系統會保留一份復原副本並使用預設值。"
          }
        }
      }
    },
    "settings.shortcuts.persistence.retry" : {
