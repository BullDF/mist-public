    "mistSlack.hint": {
      "comment": "Slack settings - Explain the roles of the three tokens",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter's Slack tools use the user token and act as you. The bot and app tokens are for Drifter in Slack."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifters Slack-Werkzeuge verwenden das Benutzer-Token und handeln in deinem Namen. Die Bot- und App-Tokens sind für Drifter in Slack."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils Slack de Drifter utilisent le jeton utilisateur et agissent en votre nom. Les jetons de bot et d’application servent à Drifter dans Slack."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DrifterのSlackツールはユーザートークンを使用し、あなたとして操作します。ボットとアプリのトークンはSlack内のDrifter用です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter 的 Slack 工具使用用户令牌并以你的身份操作。机器人和应用令牌供 Slack 中的 Drifter 使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter 的 Slack 工具使用使用者權杖並以你的身分操作。機器人和應用程式權杖供 Slack 中的 Drifter 使用。"
          }
