    "settings.privacy.contentBlocking.ruleSets.intro" : {
      "comment" : "Choose rule sets sheet - Introductory sentence",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hake die Regelsätze an, die verwendet werden sollen. „Fertig“ lädt alle noch fehlenden von ihren Anbietern herunter; ohne dein Zutun wird nichts heruntergeladen. Benutzerdefinierte Listen gelten für alle drei Schalter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check the rule sets to use. Done downloads any that are missing from their publishers; nothing is downloaded until you ask. Custom lists apply to all three switches."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cochez les jeux de règles à utiliser. « Terminé » télécharge auprès de leurs éditeurs ceux qui manquent ; rien n'est téléchargé tant que vous ne le demandez pas. Les listes personnalisées s'appliquent aux trois interrupteurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用するルールセットにチェックを入れてください。「完了」をクリックすると、チェックした項目のうち未ダウンロードのものが提供元からダウンロードされます。指示するまで何もダウンロードされません。カスタムリストは3つのスイッチすべてに適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选要使用的规则集。点按“完成”会从发布方下载缺失的规则集；未经你确认，不会下载任何内容。自定义列表对全部三个开关生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾選要使用的規則集。按「完成」會從發佈者下載尚未下載的規則集；未經你要求，不會下載任何內容。自訂清單會套用於全部三個開關。"
          }
        }
      }
    },
