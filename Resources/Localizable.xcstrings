          "stringUnit": {
            "state": "translated",
            "value": "Drifter 將在此討論串中使用 %@。"
          }
        }
      }
    },
    "mistSlack.agent.otherEngine": {
      "comment": "Slack reply when a thread's chat can't switch to the named model; %@ is a model name, like GPT-6.1 Terra",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chat can't switch engines. Start a new thread to use %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat kann die Engine nicht wechseln. Starte einen neuen Thread, um %@ zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation ne peut pas changer de moteur. Démarrez un nouveau fil pour utiliser %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットではエンジンを切り替えられません。%@ を使うには、新しいスレッドを開始してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天无法切换引擎。请开始新的会话以使用 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此聊天無法切換引擎。請開始新的討論串以使用 %@。"
          }
        }
      }
    },
    "mistSlack.agent.notTaken": {
      "comment": "Slack reply when a message cannot be delivered",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter couldn't take this message. Send it again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter konnte diese Nachricht nicht annehmen. Sende sie in einem Moment erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter n’a pas pu recevoir ce message. Renvoyez-le dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter はこのメッセージを受け取れませんでした。少し待ってからもう一度送信してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter 无法接收此消息。请稍后重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter 無法接收此訊息。請稍後重新傳送。"
          }
        }
      }
    },
    "mistSlack.answerConnected": {
      "comment": "Slack settings - This browser is the only Socket Mode connection",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected. Drifter answers your Slack threads from this Phi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden. Drifter antwortet von diesem Phi aus auf deine Slack-Threads."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté. Drifter répond à vos fils Slack depuis ce Phi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しました。この Phi から Drifter が Slack のスレッドに返信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接。Drifter 会从此 Phi 回复你的 Slack 话题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線。Drifter 會從此 Phi 回覆你的 Slack 討論串。"
          }
        }
      }
    },
    "mistSlack.answerShared": {
      "comment": "Slack settings - Multiple Socket Mode connections share events; Answer in Slack is the switch label",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected, but another app is also connected to Drifter. Slack splits events between them, so turn off Answer in Slack in the other Phi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden, aber eine andere App ist ebenfalls mit Drifter verbunden. Slack verteilt Ereignisse auf beide. Deaktiviere daher „In Slack antworten“ im anderen Phi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais une autre app est aussi connectée à Drifter. Slack répartit les événements entre elles ; désactivez donc « Répondre dans Slack » dans l’autre Phi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しましたが、別のアプリも Drifter に接続しています。Slack はイベントを分配するため、もう一方の Phi で「Slack で返信」をオフにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接，但另一个应用也连接到了 Drifter。Slack 会在两者之间分配事件，请在另一个 Phi 中关闭“在 Slack 中回复”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連線，但另一個應用程式也連線至 Drifter。Slack 會在兩者之間分配事件，請在另一個 Phi 中關閉「在 Slack 中回覆」。"
          }
        }
      }
    },
