    "settings.profiles.deleteConfirmation.browserDataAndChats" : {
      "comment" : "Profiles settings - Profile deletion confirmation distinguishing permanently removed browser data from retained conversations and explaining deferred organization while AI is unavailable",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies, Verlauf, Erweiterungen und andere Browserdaten in diesem Profil werden dauerhaft entfernt. Unterhaltungen bleiben in Phi Chat unter „Ohne Kategorie“ erhalten. Wenn KI deaktiviert oder nicht verfügbar ist, werden die Unterhaltungen verschoben, sobald KI wieder aktiviert und verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cookies, history, extensions, and other browser data in this profile will be permanently removed. Conversations will be kept in Phi Chat under Uncategorized. If AI is disabled or unavailable, conversations will be moved when AI is enabled and available again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cookies, l'historique, les extensions et les autres données de navigation de ce profil seront définitivement supprimés. Les conversations seront conservées dans Phi Chat, sous « Sans catégorie ». Si l'IA est désactivée ou indisponible, les conversations seront déplacées lorsque l'IA sera de nouveau activée et disponible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルのCookie、履歴、拡張機能、その他のブラウザデータは完全に削除されます。会話はPhi Chatの「未分類」に保持されます。AIが無効または利用できない場合は、AIが再び有効になり利用可能になったときに会話が移動されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此个人资料中的 Cookie、历史记录、扩展程序和其他浏览器数据将被永久移除。对话将保留在 Phi Chat 的“未分类”中。如果 AI 已停用或不可用，对话将在 AI 重新启用并恢复可用后再移入其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此設定檔中的 Cookie、歷史記錄、擴充功能與其他瀏覽器資料都將永久移除。對話會保留在 Phi Chat 的「未分類」中。若 AI 已停用或無法使用，對話會在 AI 重新啟用且可用時移入。"
          }
        }
      }
    },
