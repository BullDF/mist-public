    "app.changeSpaceProfileConfirmation.profileScopedMessage" : {
      "comment" : "Body of the change-Space-profile confirmation with Profile-scoped pinned tabs",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster dieses Space wird mit dem neuen Profil erneut geöffnet und seine offenen Tabs werden dort neu geladen. Website-Anmeldungen werden nicht übernommen. Lesezeichen bleiben beim Space, angeheftete Tabs sind dann die des neuen Profils."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This Space's window will be reopened with the new profile and its open tabs will be reloaded there. Site logins won't carry over. Bookmarks stay with the Space; pinned tabs will be the new profile's."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre de cet Espace sera rouverte avec le nouveau profil et ses onglets ouverts y seront rechargés. Les connexions aux sites ne seront pas conservées. Les favoris restent associés à l'Espace ; les onglets épinglés seront ceux du nouveau profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスペースのウインドウは新しいプロファイルで開き直され、開いているタブはそこで再読み込みされます。サイトのログイン状態は引き継がれません。ブックマークはスペースに残り、固定タブは新しいプロファイルのものになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此空间的窗口将以新的个人资料重新打开，其中已打开的标签页会在那里重新加载。网站登录状态不会保留。书签仍归此空间所有；固定标签页将变为新个人资料的固定标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個空間的視窗會以新的設定檔重新開啟，其中開啟的分頁也會在該視窗重新載入。網站登入狀態不會一併轉移。書籤會留在這個空間；釘選分頁則會改用新設定檔的。"
          }
        }
      }
    },
    "app.changeSpaceProfileConfirmation.spaceScopedMessage" : {
