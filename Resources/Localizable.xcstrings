    "settings.shortcuts.description.alternateNewTab": {
      "comment": "Shortcuts settings - Alternate New Tab opens the opposite of the configured New Tab action",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Seite „Neuer Tab“, wenn „Neuer Tab“ die Omnibox öffnet, oder die Omnibox, wenn „Neuer Tab“ die Seite „Neuer Tab“ öffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the New Tab Page if New Tab opens the Omnibox, or the Omnibox if it opens the New Tab Page."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir la Page Nouvel onglet si Nouvel onglet ouvre l’Omnibox, ou l’Omnibox s’il ouvre la Page Nouvel onglet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「新しいタブ」でオムニボックスが開く場合は新しいタブページを、新しいタブページが開く場合はオムニボックスを開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果“新建标签页”打开多功能框，则打开新标签页；如果它打开新标签页，则打开多功能框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若「新增分頁」開啟 Omnibox，則開啟新分頁頁面；若其開啟新分頁頁面，則開啟 Omnibox。"
          }
        }
      }
    },
