    "mistSync.turnOffMessage": {
      "comment": "Sync - Turning off sync preserves local browser data",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your passwords, profiles, Spaces, bookmarks, and mail accounts will stay on this Mac. Changes on this Mac will stop syncing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Passwörter, Profile, Spaces, Lesezeichen und E-Mail-Accounts bleiben auf diesem Mac. Änderungen auf diesem Mac werden nicht mehr synchronisiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos mots de passe, profils, Espaces, favoris et comptes de messagerie resteront sur ce Mac. Les modifications de ce Mac ne seront plus synchronisées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード、プロファイル、スペース、ブックマーク、メールアカウントはこのMacに残ります。このMacでの変更は同期されなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码、个人资料、空间、书签和邮件账户将保留在此 Mac 上。此 Mac 上的更改将不再同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼、個人檔案、空間、書籤和郵件帳號將保留在此 Mac 上。此 Mac 上的變更將不再同步。"
          }
        }
      }
    },
