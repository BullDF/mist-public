      "comment": "Sync - Explain where to use the pairing code",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy this code to the Sync settings on your other Mac."
          }
        },
        "de": {
