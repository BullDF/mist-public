    "about.acknowledgements.text" : {
      "comment" : "About window - Acknowledgements sentence; the three placeholders are, in order, the Chromium project name link, Chromium's open source software link, and other open source software link",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi wird ermöglicht durch das Open-Source-Projekt %1$@, die %2$@ von Chromium sowie weitere %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Phi is made possible by the %1$@ open source project, Chromium's %2$@, as well as other %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phi est rendu possible par le projet open source %1$@, les %2$@ de Chromium, ainsi que d'autres %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiは、オープンソースプロジェクトの%1$@、Chromiumの%2$@、そしてその他の%3$@によって実現しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
