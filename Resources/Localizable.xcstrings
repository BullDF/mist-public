    "mistSlack.errorTokenFormat": {
      "comment": "Slack settings - Malformed token error; preserve token prefixes",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the tokens: the user token starts with xoxp-, the bot token with xoxb- and the app token with xapp-."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Tokens: Das Benutzer-Token beginnt mit xoxp-, das Bot-Token mit xoxb- und das App-Token mit xapp-."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les jetons : le jeton utilisateur commence par xoxp-, celui de bot par xoxb- et celui d’application par xapp-."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンを確認してください。ユーザートークンはxoxp-、ボットトークンはxoxb-、アプリトークンはxapp-で始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查令牌：用户令牌以 xoxp- 开头，机器人令牌以 xoxb- 开头，应用令牌以 xapp- 开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查權杖：使用者權杖以 xoxp- 開頭，機器人權杖以 xoxb- 開頭，應用程式權杖以 xapp- 開頭。"
          }
        }
      }
    },
