    },
    "mistSync.errorKind": {
      "comment": "Sync - Unsupported kind of synchronized data",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac does not support a received sync record. Update Phi and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac unterstützt einen empfangenen Synchronisierungseintrag nicht. Aktualisiere Phi und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne prend pas en charge un enregistrement de synchronisation reçu. Mettez Phi à jour et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは受信した同期レコードに対応していません。Phiを更新して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 不支持收到的同步记录。请更新 Phi 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 不支援收到的同步記錄。請更新 Phi 後再試。"
          }
        }
      }
    },
