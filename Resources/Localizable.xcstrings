    "settings.shortcuts.recording.unsupported" : {
      "comment" : "Shortcuts settings - Recording rejected an unmodified key or a Shift-only printable key to preserve normal typing",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende eine Sondertaste. Buchstaben und Symbole erfordern die Befehlstaste, die Steuerungstaste oder die Wahltaste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a modifier key. Letters and symbols require Command, Control, or Option."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez une touche de modification. Les lettres et les symboles nécessitent Commande, Contrôle ou Option."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
