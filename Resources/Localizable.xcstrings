    "settings.shortcuts.persistence.saveFailed" : {
      "comment" : "Shortcuts settings - A failed save leaves the previous shortcuts active",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderung konnte nicht gesichert werden. Deine bisherigen Tastaturkurzbefehle sind weiterhin aktiv. Versuche die Änderung erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The change could not be saved. Your previous shortcuts are still active. Try the change again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'enregistrer la modification. Vos raccourcis précédents sont toujours actifs. Réessayez la modification."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更を保存できませんでした。以前のショートカットは引き続き有効です。もう一度変更してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法存储此更改。你之前的快捷键仍然有效。请再次尝试此更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存變更。你先前的快速鍵仍然有效，請再試一次。"
          }
        }
      }
    },
