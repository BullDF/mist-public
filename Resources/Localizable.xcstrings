    "mail.settings.removeMessage": {
      "comment": "Mail settings confirmation - Removing local account data only",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail downloaded to Phi is deleted. Nothing is deleted from the server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages téléchargés dans Phi sont supprimés. Rien n’est supprimé du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Phi geladene E-Mails werden gelöscht. Auf dem Server wird nichts gelöscht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiにダウンロードされたメールは削除されます。サーバ上のメールは削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载到 Phi 的邮件将被删除。服务器上的内容不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載到 Phi 的郵件將被刪除。伺服器上的內容不會被刪除。"
          }
        }
      }
    },
    "mail.settings.removeMessageSynced": {
      "comment": "Mail account removal alert - Message when Mist sync is on",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail downloaded to Phi is deleted, and the account is removed from your other Macs. Nothing is deleted from the server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages téléchargés dans Phi sont supprimés, et le compte est supprimé de vos autres Mac. Rien n’est supprimé du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Phi geladene E-Mails werden gelöscht und der Account wird von deinen anderen Macs entfernt. Auf dem Server wird nichts gelöscht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiにダウンロードされたメールは削除され、ほかのMacからもアカウントが削除されます。サーバ上のメールは削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载到 Phi 的邮件将被删除，账户也会从你的其他 Mac 上移除。服务器上的内容不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載到 Phi 的郵件將被刪除，帳號也會從你的其他 Mac 上移除。伺服器上的內容不會被刪除。"
          }
        }
      }
    },
