    "mistSlack.agent.noWindow": {
      "comment": "Slack reply when no normal browser window is open",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mist has no open window, so Drifter can't start this chat. Open a Mist window and send your message again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mist hat kein offenes Fenster, daher kann Drifter diesen Chat nicht starten. Öffne ein Mist-Fenster und sende deine Nachricht erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune fenêtre Mist n’est ouverte, Drifter ne peut donc pas démarrer cette conversation. Ouvrez une fenêtre Mist et renvoyez votre message."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mist のウインドウが開いていないため、Drifter はこのチャットを開始できません。Mist のウインドウを開いて、メッセージをもう一度送信してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mist 没有打开的窗口，因此 Drifter 无法开始此聊天。请打开 Mist 窗口并重新发送消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mist 沒有開啟的視窗，因此 Drifter 無法開始此聊天。請開啟 Mist 視窗並重新傳送訊息。"
          }
        }
      }
    },
    "mistSlack.agent.modelSet": {
      "comment": "Slack reply to a message that only names a model; %@ is the model and effort, like Fable 5.1 · medium",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drifter will use %@ in this thread."
