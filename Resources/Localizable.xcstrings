    "mistSync.errorFrame": {
      "comment": "Sync - Invalid relay protocol response",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync server sent an invalid response."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Synchronisierungsserver hat eine ungültige Antwort gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de synchronisation a envoyé une réponse invalide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期サーバーから無効な応答が送信されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
