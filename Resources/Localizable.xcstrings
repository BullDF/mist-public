    "settings.advanced.agentControl.description" : {
      "comment" : "Advanced settings - Explains local agent control and its switch",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht Agentenwerkzeugen auf diesem Mac (Claude Code, Codex), Phi ohne Nachfrage über das DevTools-Protokoll und einen privaten Socket zu steuern. Beim Ausschalten werden sie sofort getrennt. Drifter funktioniert unabhängig davon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets agent tools on this Mac (Claude Code, Codex) drive Phi over the DevTools Protocol through a private socket, without asking. Turning this off disconnects them right away. Drifter works either way."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet aux outils agents de ce Mac (Claude Code, Codex) de contrôler Phi sans demander, via le protocole DevTools et un socket privé. La désactivation les déconnecte immédiatement. Drifter fonctionne dans les deux cas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上のエージェントツール（Claude Code、Codex）が、プライベートソケットを介してDevToolsプロトコルで確認なしにPhiを操作できるようにします。オフにするとすぐに切断されます。Drifterはどちらの場合も動作します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许此 Mac 上的智能体工具（Claude Code、Codex）通过私有套接字使用 DevTools 协议直接控制 Phi，无需询问。关闭后会立即断开连接。Drifter 不受此设置影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許此 Mac 上的代理工具（Claude Code、Codex）透過私人通訊端使用 DevTools 協定直接控制 Phi，無需詢問。關閉後會立即中斷連線。Drifter 不受此設定影響。"
          }
        }
      }
    },
