    "drifterSettings.hint": {
      "comment": "Drifter settings - Explains that the settings are new chats' defaults",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every new chat starts with these settings. A change in a chat's composer applies to that chat only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder neue Chat beginnt mit diesen Einstellungen. Eine Änderung im Eingabefeld eines Chats gilt nur für diesen Chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nouvelle discussion commence avec ces réglages. Une modification dans le champ de message d’une discussion ne s’applique qu’à celle-ci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいチャットはすべてこの設定で始まります。チャットの入力欄での変更は、そのチャットにのみ適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个新聊天都以这些设置开始。在聊天输入框中所做的更改仅适用于该聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個新聊天都以這些設定開始。在聊天輸入框中所做的變更僅適用於該聊天。"
          }
        }
      }
    },
