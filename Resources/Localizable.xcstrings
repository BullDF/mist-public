    "settings.navigations.peek.autoToggle.description" : {
      "comment" : "Navigations settings - Explanation of the automatic Peek View toggle for pinned tabs and bookmarks",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, die die Website eines angehefteten Tabs oder Lesezeichens verlassen, öffnen sich in einem Peek-Panel statt in einem neuen Tab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Links that leave a pinned tab’s or bookmark’s site open in a Peek panel instead of a new tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens qui quittent le site d'un onglet épinglé ou d'un favori s'ouvrent dans un panneau Peek au lieu d'un nouvel onglet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定タブやブックマークのサイト外へ移動するリンクは、新しいタブではなくPeekビューで開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开固定的标签页或书签所在网站的链接，会在 Peek 面板中打开，而不是新标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開釘選分頁或書籤所在網站的連結，會在 Peek 面板中開啟，而非新分頁。"
          }
        }
      }
    },
    "settings.navigations.peek.autoToggle.title" : {
      "comment" : "Navigations settings - Toggle title for automatically opening cross-site links from pinned tabs and bookmarks in Peek View",
      "extractionState" : "extracted_with_value",
      "localizations" : {
